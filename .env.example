# Copy to .env. Everything has a laptop default.

HSS_OPENSEARCH_URL=http://localhost:9201
HSS_INDEX=products
HSS_REDIS_URL=redis://localhost:6381/0

# Catalog size and evaluation sample built by `hss prepare` (deterministic with the seed)
HSS_CATALOG_SIZE=200000
HSS_EVAL_QUERIES=2000
HSS_SEED=42

# Models (CPU). Downloaded once into data/models.
HSS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HSS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HSS_RERANK_TOP=50

# API
HSS_RATE_LIMIT=120/minute
HSS_ADMIN_KEY=
HSS_CACHE_TTL_S=300
HSS_CORS_ORIGINS=http://localhost:5173,http://localhost:4310
HSS_LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
